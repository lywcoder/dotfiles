# Example only. Contains no credentials and is not loaded automatically.
# Keep real values outside this repository, or use a credential manager.
# Interactive Bash: read -r -s -p 'API key: ' OPENAI_API_KEY; printf '\n'; export OPENAI_API_KEY
# Interactive Zsh: read -r -s 'OPENAI_API_KEY?API key: '; printf '\n'; export OPENAI_API_KEY
# Clear after use: unset OPENAI_API_KEY
